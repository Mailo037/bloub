{
  "name": "bloub-pet",
  "productName": "Bloub Pet",
  "version": "1.1.0",
  "description": "Interactive AI desktop pet companion powered by the procedural bloub avatar engine",
  "author": "kasto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mailo037/bloub.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "node tools/dev.mjs",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.bloub.pet",
    "productName": "Bloub Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloub Pet"
    },
    "publish": {
      "provider": "github",
      "owner": "Mailo037",
      "repo": "bloub"
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

